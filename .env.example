# Copy to .env and fill in. Only GROQ_API_KEY is required.
# Drive/Sheets/Gmail are optional for LOCAL testing: leave them blank and the
# zip is kept in results/, the email is printed, and the quota is NOT enforced.

MAX_UPLOAD_MB=50

# --- Speech to text: Groq hosted Whisper (the only backend) ---
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3-turbo
GROQ_MAX_UPLOAD_MB=25          # 25 free tier, 100 dev tier

# --- Google Drive (service account) ---
GOOGLE_SA_JSON=/path/service-account.json
GDRIVE_FOLDER_ID=

# --- Google Sheet: customer log + per-email quota (same service account;
#     share the sheet with its email as Editor) ---
GOOGLE_SHEET_ID=               # the /d/<THIS>/edit part of the sheet URL
SHEET_TAB=customers-info
MAX_JOBS_PER_EMAIL=5

# --- Gmail SMTP (App Password, 16 chars) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=
