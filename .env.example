# Copy to .env and fill in. All optional for LOCAL testing:
# leave Drive/Gmail blank and the zip is kept in results/ instead.

MAX_UPLOAD_MB=50
WHISPER_MODEL=small

# --- Google Drive (service account) ---
GOOGLE_SA_JSON=/path/service-account.json
GDRIVE_FOLDER_ID=

# --- Gmail SMTP (App Password, 16 chars) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=
